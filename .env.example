# Required — your Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...

# Model your key can access. Examples: claude-sonnet-4-5, claude-sonnet-5,
# claude-3-5-sonnet-20241022. Set to whatever you have access to.
CLAUDE_MODEL=claude-sonnet-4-5

# Optional — a faster/cheaper model for planning + critique steps.
# CLAUDE_FAST_MODEL=claude-3-5-haiku-20241022

# Optional — enables the Researcher's real web_search tool (https://tavily.com/).
# Without it, the demo still runs; the Researcher uses its own knowledge.
# TAVILY_API_KEY=tvly-...

# Optional — max output tokens per agent call.
# MAX_TOKENS=2000
